    {
        "id": "76479dfb41d76145",
        "type": "function",
        "z": "e0899595ae582aaa",
        "name": "Texto do nível",
        "func": "// troca o nivel que a placa manda por um texto e uma cor (iguais aos da tela da placa)\nvar nivel = msg.payload;\n\nif (nivel == \"BAIXO\") { msg.payload = \"Risco baixo\"; msg.cor = \"green\"; }\nif (nivel == \"MEDIO\") { msg.payload = \"Risco médio\"; msg.cor = \"orange\"; }\nif (nivel == \"ALTO\") { msg.payload = \"Risco alto\"; msg.cor = \"red\"; }\nif (nivel == \"LETAL\") { msg.payload = \"Água em temperatura letal\"; msg.cor = \"purple\"; }\nif (nivel == \"ERRO\") { msg.payload = \"Falha no sensor\"; msg.cor = \"blue\"; }\nif (nivel == \"PAUSADO\") { msg.payload = \"Monitoramento pausado\"; msg.cor = \"gray\"; }\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,

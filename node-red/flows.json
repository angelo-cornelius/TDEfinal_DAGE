    {
        "id": "6dc9cc6aa8d1e2a9",
        "type": "function",
        "z": "e0899595ae582aaa",
        "name": "Simula a armadilha 02",
        "func": "// simula uma segunda armadilha: as leituras mudam um pouco a cada 3 s\n// e o risco e calculado igual ao firmware, com os limites padrao\nvar ar = context.get(\"ar\") || 28;\nvar umidade = context.get(\"umidade\") || 70;\nvar agua = context.get(\"agua\") || 26;\n\nar = ar + Math.random() - 0.5;\numidade = umidade + (Math.random() - 0.5) * 4;\nagua = agua + (Math.random() - 0.5) * 0.6;\n\n// nao deixa os valores sairem de uma faixa que faz sentido\nif (ar < 20) ar = 20;\nif (ar > 34) ar = 34;\nif (umidade < 50) umidade = 50;\nif (umidade > 95) umidade = 95;\nif (agua < 20) agua = 20;\nif (agua > 32) agua = 32;\n\ncontext.set(\"ar\", ar);\ncontext.set(\"umidade\", umidade);\ncontext.set(\"agua\", agua);\n\n// soma os pontos (maximo 7)\nvar indice = 0;\nif (ar >= 26 && ar <= 30) indice += 2;\nelse if (ar >= 18 && ar <= 34) indice += 1;\n\nif (umidade > 70) indice += 2;\nelse if (umidade > 60) indice += 1;\n\nif (agua >= 22 && agua <= 34) indice += 3;\nelse if (agua >= 15 && agua <= 36) indice += 1;\n\nvar nivel = \"BAIXO\";\nif (indice > 2) nivel = \"MEDIO\";\nif (indice > 5) nivel = \"ALTO\";\n\nvar topico = \"dage/armadilha/02/\";\nreturn [[\n    { topic: topico + \"ar\", payload: ar.toFixed(1) },\n    { topic: topico + \"umidade\", payload: umidade.toFixed(1) },\n    { topic: topico + \"agua\", payload: agua.toFixed(1) },\n    { topic: topico + \"indice\", payload: String(indice) },\n    { topic: topico + \"nivel\", payload: nivel },\n    { topic: topico + \"status\", payload: \"conectada\" }\n]];\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 540,
        "wires": [
